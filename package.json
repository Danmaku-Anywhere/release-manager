{
  "name": "release-manager",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "tauri": "tauri",
    "type-check": "tsgo --noEmit",
    "lint": "biome check --fix",
    "lint:ci": "biome ci",
    "test": "pnpm test:rust && pnpm test:ui",
    "test:rust": "cargo test -p release-manager-core --manifest-path src-tauri/Cargo.toml",
    "test:ui": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@11.2.2"
}
